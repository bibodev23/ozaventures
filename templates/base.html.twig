<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Centre aéré{% endblock %}</title>
        <meta name="theme-color" content="#f8fafd">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-title" content="Oz'Aventure">
        <meta name="apple-mobile-web-app-status-bar-style" content="default">
        <link rel="manifest" href="{{ asset('site.webmanifest') }}">
        <link rel="apple-touch-icon" href="{{ asset('icons/apple-touch-icon.png') }}">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}?v=20260605-clean-animator-copy">
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    </head>
    <body>
        {% set current_route = app.request.attributes.get('_route') %}
        <a class="skip-link" href="#content">Aller au contenu</a>

        <div class="{{ app.user ? 'app-shell' : 'auth-shell' }}">
            {% if app.user %}
                <aside class="app-sidebar">
                    {% set brand_route = is_granted('ROLE_DIRECTOR') ? 'app_dashboard' : 'app_animator_portal' %}
                    <a class="brand" href="{{ path(brand_route) }}">
                        <span class="brand-mark">OZ</span>
                        <span>
                            <strong>Oz'Aventure</strong>
                            <small>{{ is_granted('ROLE_DIRECTOR') ? 'Pilotage direction' : 'Espace animateur' }}</small>
                        </span>
                    </a>

                    <div class="sidebar-section">
                        <p class="sidebar-label">Menu</p>
                        <nav class="nav" aria-label="Navigation principale">
                            {% if is_granted('ROLE_DIRECTOR') %}
                                {% set nav_items = [
                                    {label: 'Dashboard', icon: 'DB', route: 'app_dashboard', routes: ['app_home', 'app_dashboard']},
                                    {label: 'Planning', icon: 'PL', route: 'app_daily_planning', match: 'app_daily_planning', turbo: false},
                                    {label: 'Horaires', icon: 'HR', route: 'app_work_schedule', match: 'app_work_schedule'},
                                    {label: 'Sorties', icon: 'SO', route: 'app_outings', match: 'app_outing'},
                                    {label: 'Enfants', icon: 'EN', route: 'app_children', match: 'app_child'},
                                    {label: 'Animateurs', icon: 'AN', route: 'app_animators', match: 'app_animator'},
                                    {label: 'Direction', icon: 'DI', route: 'app_directors', match: 'app_director'}
                                ] %}
                                {% for item in nav_items %}
                                    {% set is_active = item.routes is defined ? current_route in item.routes : current_route starts with item.match %}
                                    <a
                                        class="{{ is_active ? 'is-active' : '' }}"
                                        href="{{ path(item.route) }}"
                                        {% if item.turbo is defined and item.turbo == false %}data-turbo="false"{% endif %}
                                        {% if is_active %}aria-current="page"{% endif %}
                                    >
                                        <span class="nav-icon">{{ item.icon }}</span>
                                        <span>{{ item.label }}</span>
                                    </a>
                                {% endfor %}
                            {% elseif is_granted('ROLE_ANIMATOR') %}
                                {% set nav_items = [
                                    {label: 'Mon espace', icon: 'ME', route: 'app_animator_portal', routes: ['app_animator_portal']},
                                    {label: 'Semaine', icon: 'SE', route: 'app_animator_portal_schedules', routes: ['app_animator_portal_schedules', 'app_animator_portal_planning']},
                                    {label: 'Sorties', icon: 'SO', route: 'app_animator_portal_outings', match: 'app_animator_portal_outing'},
                                    {label: 'Enfants', icon: 'EN', route: 'app_animator_portal_children', match: 'app_animator_portal_child'}
                                ] %}
                                {% for item in nav_items %}
                                    {% set is_active = item.routes is defined ? current_route in item.routes : current_route starts with item.match %}
                                    <a
                                        class="{{ is_active ? 'is-active' : '' }}"
                                        href="{{ path(item.route) }}"
                                        {% if is_active %}aria-current="page"{% endif %}
                                    >
                                        <span class="nav-icon">{{ item.icon }}</span>
                                        <span>{{ item.label }}</span>
                                    </a>
                                {% endfor %}
                            {% endif %}
                        </nav>
                    </div>

                    <div class="sidebar-section sidebar-section-bottom">
                        <p class="sidebar-label">General</p>
                        <a class="sidebar-link" href="#content"><span class="nav-icon">HP</span>Aide</a>
                        <a class="sidebar-link" href="{{ path('app_logout') }}"><span class="nav-icon">LO</span>Déconnexion</a>
                    </div>

                </aside>

                <div class="app-workspace">
                    <header class="workspace-topbar">
                        {% if is_granted('ROLE_DIRECTOR') %}
                            <twig:GlobalSearch />
                        {% else %}
                            <div class="search-pill drive-mobile-search" aria-label="Espace animateur">
                                <span class="drive-burger" aria-hidden="true"></span>
                                <span>Oz'Aventure</span>
                            </div>
                        {% endif %}
                        <div class="workspace-actions">
                            {% set user_display_name = app.user.firstName|default('') ?: app.user.userIdentifier %}
                            {% set user_avatar = (app.user.firstName|default('')|slice(0, 1) ~ app.user.lastName|default('')|slice(0, 1))|trim ?: app.user.userIdentifier|slice(0, 2) %}
                            <span class="user-menu">
                                <span class="user-chip">
                                    <span class="avatar">{{ user_avatar|upper }}</span>
                                    <span>
                                        <strong>{{ user_display_name }}</strong>
                                        <small>Compte connecté</small>
                                    </span>
                                </span>
                                <span class="workspace-logout-link workspace-account-menu">
                                    {% if is_granted('ROLE_ANIMATOR') %}
                                        <a href="{{ path('app_account_password') }}">Mot de passe</a>
                                    {% endif %}
                                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                                </span>
                            </span>
                        </div>
                    </header>
            {% endif %}

            <main id="content" class="page {{ app.user ? '' : 'auth-page' }}">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash flash-{{ label }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </main>

            {% if app.user %}
                </div>
            {% endif %}
        </div>

        {% block floating_actions %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </body>
</html>
