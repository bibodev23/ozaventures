{% extends 'base.html.twig' %}

{% block title %}Enfants{% endblock %}

{% block body %}
    <section class="drive-page animator-drive-page">
        <header class="drive-hero drive-hero-compact">
            <p class="drive-kicker">Enfants</p>
            <h1>Liste des enfants</h1>
            <p>Retrouve les fiches enfants de la saison.</p>
        </header>

        {% if children is empty %}
            <div class="drive-empty">Aucun enfant inscrit pour le moment.</div>
        {% else %}
            {% for group in groups %}
                {% set group_children = children|filter(child => child.ageGroup == group.value) %}
                <details class="drive-section drive-accordion-section" {% if loop.first %}open{% endif %}>
                    <summary class="drive-section-heading drive-accordion-summary">
                        <h2>{{ group.label }}</h2>
                        <span>{{ group_children|length }} enfant{{ group_children|length > 1 ? 's' : '' }}</span>
                    </summary>
                    <div class="drive-list">
                        {% for child in group_children %}
                            <a class="drive-row" href="{{ path('app_animator_portal_child_show', {id: child.id}) }}">
                                <span class="drive-avatar">{{ child.firstName|slice(0, 1) }}{{ child.lastName|slice(0, 1) }}</span>
                                <span><strong>{{ child.fullName }}</strong><small>{{ child.age ? child.age ~ ' ans' : child.ageGroupLabel }}</small></span>
                                <em>Voir</em>
                            </a>
                        {% else %}
                            <div class="drive-empty">Aucun enfant dans ce groupe.</div>
                        {% endfor %}
                    </div>
                </details>
            {% endfor %}
        {% endif %}
    </section>
{% endblock %}
