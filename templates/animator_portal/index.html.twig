{% extends 'base.html.twig' %}

{% block title %}Mon espace animateur{% endblock %}

{% block body %}
    <section class="drive-page animator-drive-page">
        <header class="drive-hero">
            <p class="drive-kicker">Espace animateur</p>
            <h1>Bonjour {{ animator.firstName }}</h1>
            <p>Retrouve rapidement tes horaires, ton planning, tes sorties et les fiches enfants utiles.</p>
        </header>

        {% if user.mustChangePassword %}
            <section class="drive-alert-card">
                <span class="drive-dot"></span>
                <div>
                    <strong>Mot de passe initial à remplacer</strong>
                    <span>Change ton mot de passe pour sécuriser ton accès.</span>
                </div>
                <a href="{{ path('app_account_password') }}">Modifier</a>
            </section>
        {% endif %}

        <section class="drive-quick-grid" aria-label="Résumé animateur">
            <a class="drive-stat-card is-blue" href="{{ path('app_animator_portal_schedules') }}">
                <span>Semaine</span>
                <strong>{{ weekly_total_label }}</strong>
                <small>{{ week_start|date('d/m') }} - {{ week_end|date('d/m') }}</small>
            </a>
            <a class="drive-stat-card is-green" href="{{ path('app_animator_portal_outings') }}">
                <span>Sorties</span>
                <strong>{{ upcoming_outings_count }}</strong>
                <small>à venir</small>
            </a>
            <a class="drive-stat-card is-yellow" href="{{ path('app_animator_portal_planning') }}">
                <span>Missions</span>
                <strong>{{ today_tasks|length }}</strong>
                <small>aujourd'hui</small>
            </a>
            <a class="drive-stat-card is-red" href="{{ path('app_animator_portal_children') }}">
                <span>Enfants</span>
                <strong>{{ children_count }}</strong>
                <small>fiches</small>
            </a>
        </section>

        <section class="drive-section">
            <div class="drive-section-heading">
                <h2>Accès rapide</h2>
                <span>Comme des dossiers utiles</span>
            </div>
            <div class="drive-list">
                <a class="drive-row" href="{{ path('app_animator_portal_schedules') }}">
                    <span class="drive-folder-icon drive-folder-blue"></span>
                    <span><strong>Mes horaires</strong><small>Semaine du {{ week_start|date('d/m') }}</small></span>
                    <em>Ouvrir</em>
                </a>
                <a class="drive-row" href="{{ path('app_animator_portal_planning') }}">
                    <span class="drive-folder-icon drive-folder-yellow"></span>
                    <span><strong>Planning du jour</strong><small>{{ today_tasks|length }} mission(s) assignée(s)</small></span>
                    <em>Ouvrir</em>
                </a>
                <a class="drive-row" href="{{ path('app_animator_portal_outings') }}">
                    <span class="drive-folder-icon drive-folder-green"></span>
                    <span><strong>Mes sorties</strong><small>{{ validated_outings_count }} validée(s), {{ pending_outings_count }} en attente</small></span>
                    <em>Ouvrir</em>
                </a>
                <a class="drive-row" href="{{ path('app_animator_portal_children') }}">
                    <span class="drive-folder-icon drive-folder-red"></span>
                    <span><strong>Liste des enfants</strong><small>Consultation uniquement</small></span>
                    <em>Ouvrir</em>
                </a>
            </div>
        </section>

        <section class="drive-section">
            <div class="drive-section-heading">
                <h2>Cette semaine</h2>
                <a href="{{ path('app_animator_portal_schedules') }}">Tout voir</a>
            </div>
            <div class="drive-day-strip">
                {% for day in week_days %}
                    {% set shift = day.shift %}
                    <article class="drive-day-tile {{ shift ? 'has-shift' : '' }}">
                        <span>{{ day.label }}</span>
                        <strong>{{ day.date|date('d/m') }}</strong>
                        {% if shift %}
                            <small>{{ shift.startTime|date('H:i') }} - {{ shift.endTime|date('H:i') }}</small>
                            <em>{{ shift.workedHoursLabel }}</em>
                        {% else %}
                            <small>Repos</small>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
        </section>

        <section class="drive-section">
            <div class="drive-section-heading">
                <h2>Prochaines sorties</h2>
                <a href="{{ path('app_animator_portal_outings') }}">Tout voir</a>
            </div>
            {% if upcoming_outings is empty %}
                <div class="drive-empty">Aucune sortie à venir pour le moment.</div>
            {% else %}
                <div class="drive-list">
                    {% for outing in upcoming_outings %}
                        <a class="drive-row" href="{{ path('app_animator_portal_outing_show', {id: outing.id}) }}">
                            <span class="drive-file-icon">{{ outing.departureAt|date('d') }}</span>
                            <span><strong>{{ outing.destination }}</strong><small>{{ outing.departureAt|date('d/m') }} · {{ outing.children|length }} enfant(s) · {{ outing.statusLabel }}</small></span>
                            <em>Ouvrir</em>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </section>
{% endblock %}
